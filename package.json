{
  "name": "oranges-eat2",
  "version": "1.0.0",
  "description": "「橙子吃吃」共享美食地图微信小程序",
  "scripts": {
    "dev:custom": "uni -p",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "clean:mp-weixin": "node scripts/clean-mp-weixin.mjs",
    "build:mp-weixin": "uni build -p mp-weixin && node scripts/sync-cloudfunctions.mjs && node scripts/install-cloudfunction-deps.mjs",
    "rebuild:mp-weixin": "npm run clean:mp-weixin && npm run build:mp-weixin",
    "rebuild:reload": "node scripts/rebuild-and-reload.mjs",
    "build:mp-weixin:cloud-install": "uni build -p mp-weixin && node scripts/sync-cloudfunctions.mjs",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813001",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813001",
    "@dcloudio/uni-components": "3.0.0-5020420260813001",
    "@dcloudio/uni-h5": "3.0.0-5020420260813001",
    "@dcloudio/uni-mp-alipay": "3.0.0-5020420260813001",
    "@dcloudio/uni-mp-baidu": "3.0.0-5020420260813001",
    "@dcloudio/uni-mp-jd": "3.0.0-5020420260813001",
    "@dcloudio/uni-mp-kuaishou": "3.0.0-5020420260813001",
    "@dcloudio/uni-mp-lark": "3.0.0-5020420260813001",
    "@dcloudio/uni-mp-qq": "3.0.0-5020420260813001",
    "@dcloudio/uni-mp-toutiao": "3.0.0-5020420260813001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813001",
    "@dcloudio/uni-mp-xhs": "3.0.0-5020420260813001",
    "@wot-ui/ui": "2.3.2",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5020420260813001",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813001",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.1.3",
    "miniprogram-api-typings": "^5.2.3",
    "sass": "1.102.0",
    "sharp": "0.35.3",
    "typescript": "~5.5.4",
    "vite": "5.2.8",
    "vitest": "4.1.10",
    "vue-tsc": "^2.2.12"
  }
}
