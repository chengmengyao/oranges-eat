{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "橙子吃吃"
      }
    },
    {
      "path": "pages/food/food",
      "style": {
        "navigationBarTitleText": "美食清单"
      }
    },
    {
      "path": "pages/manage/manage",
      "style": {
        "navigationBarTitleText": "清单管理"
      }
    },
    {
      "path": "pages/invite/index",
      "style": {
        "navigationBarTitleText": "邀请加入"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "橙子吃吃",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#FAE8EB"
  },
"tabBar": {
    "color": "#6B6F73",
    "selectedColor": "#36393B",
    "backgroundColor": "#F2F4F5",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "地图",
        "iconPath": "static/tabbar/map.png",
        "selectedIconPath": "static/tabbar/map.png"
      },
      {
        "pagePath": "pages/food/food",
        "text": "美食",
        "iconPath": "static/tabbar/food.png",
        "selectedIconPath": "static/tabbar/food.png"
      },
      {
        "pagePath": "pages/manage/manage",
        "text": "管理",
        "iconPath": "static/tabbar/manage.png",
        "selectedIconPath": "static/tabbar/manage.png"
      }
    ]
  }
}
